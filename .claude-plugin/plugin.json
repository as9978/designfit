{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "designfit",
  "version": "0.2.1",
  "description": "Validate AI-built front-ends against their Figma design — deterministic token + geometry conformance, not pixels.",
  "author": {
    "name": "Ali Seifaldini",
    "url": "https://github.com/as9978"
  },
  "homepage": "https://github.com/as9978/designfit#readme",
  "repository": "https://github.com/as9978/designfit",
  "license": "MIT",
  "keywords": [
    "figma",
    "design-tokens",
    "design-system",
    "mcp",
    "frontend",
    "visual-regression"
  ],
  "skills": ["./skill/"],
  "userConfig": {
    "figma_token": {
      "type": "string",
      "title": "Figma personal access token",
      "description": "Lets designfit_extract read frames via Figma's REST API. Optional: without it, paste the /nodes JSON instead.",
      "sensitive": true,
      "required": false
    }
  },
  "mcpServers": {
    "designfit": {
      "command": "npx",
      "args": ["-y", "designfit@0.2"],
      "env": {
        "FIGMA_TOKEN": "${user_config.figma_token}"
      }
    }
  }
}
